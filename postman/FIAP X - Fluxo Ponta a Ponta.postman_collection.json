{
  "info": {
    "_postman_id": "609a0310-ef12-46b5-9ffc-6145612fc404",
    "name": "FIAP X - Fluxo Completo via Kong",
    "description": "Fluxo completo pelo Load Balancer do Kong: Grafana, cadastro, autenticacao, upload, processamento assincrono, consulta e download do ZIP.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const requestId = pm.response.headers.get('X-Request-ID');",
          "pm.test('Resposta passou pelo Kong e possui X-Request-ID', () => {",
          "  pm.expect(requestId).to.match(/^[0-9a-f-]{36}$/i);",
          "});",
          "if (requestId) pm.collectionVariables.set('lastRequestId', requestId);"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "kongBaseUrl",
      "value": "http://ab1488290cddc4521b73d0707198d030-1f6f0932cb0d2ea5.elb.us-east-1.amazonaws.com"
    },
    {
      "key": "grafanaUrl",
      "value": "{{kongBaseUrl}}/grafana"
    },
    {
      "key": "notificationEmail",
      "value": "SEU_EMAIL@gmail.com"
    },
    {
      "key": "customerPassword",
      "value": "Secret-key1!"
    },
    {
      "key": "customerEmail",
      "value": ""
    },
    {
      "key": "customerId",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "videoId",
      "value": ""
    },
    {
      "key": "processingPollAttempts",
      "value": "0"
    },
    {
      "key": "lastRequestId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 - Observabilidade",
      "item": [
        {
          "name": "01 - Validar Grafana pelo Kong",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Grafana esta disponivel', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().database).to.eql('ok');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{grafanaUrl}}/api/health",
            "description": "Valida a rota publica do Grafana sem expor Prometheus, Loki ou Jaeger."
          }
        },
        {
          "name": "02 - Pagina de login do Grafana",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Pagina de login do Grafana esta acessivel', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.text()).to.include('Grafana');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{grafanaUrl}}/login"
          }
        }
      ]
    },
    {
      "name": "01 - Cliente",
      "item": [
        {
          "name": "01 - Cadastrar cliente",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const inbox = String(pm.collectionVariables.get('notificationEmail') || '').trim();",
                  "const parts = inbox.split('@');",
                  "if (parts.length !== 2) throw new Error('Defina notificationEmail nas variaveis da collection.');",
                  "const local = parts[0].split('+')[0];",
                  "const alias = `${local}+fiapx-${Date.now()}@${parts[1]}`;",
                  "pm.collectionVariables.set('customerEmail', alias);",
                  "pm.collectionVariables.set('processingPollAttempts', '0');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Cliente foi criado', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "  const customer = pm.response.json();",
                  "  pm.collectionVariables.set('customerId', customer.id);",
                  "  pm.expect(customer.email).to.eql(pm.collectionVariables.get('customerEmail'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Teste FIAP X\",\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\",\n  \"preferredNotificationChannel\": \"EMAIL\"\n}"
            },
            "url": "{{kongBaseUrl}}/customers",
            "description": "Gera automaticamente um alias Gmail unico para permitir varias execucoes e receber a notificacao na mesma caixa de entrada."
          }
        },
        {
          "name": "02 - Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login retornou JWT', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const login = pm.response.json();",
                  "  pm.expect(login.tokenType).to.eql('Bearer');",
                  "  pm.collectionVariables.set('accessToken', login.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
            },
            "url": "{{kongBaseUrl}}/auth/login"
          }
        },
        {
          "name": "03 - Consultar cliente autenticado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Token identifica o cliente criado', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('customerId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{kongBaseUrl}}/customers/{{customerId}}"
          }
        }
      ]
    },
    {
      "name": "02 - Processamento",
      "item": [
        {
          "name": "01 - Upload do video",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Manager aceitou o video', () => pm.response.to.have.status(202));",
                  "if (pm.response.code === 202) {",
                  "  const upload = pm.response.json();",
                  "  pm.expect(upload.status).to.eql('PENDING_PROCESSING');",
                  "  pm.collectionVariables.set('videoId', upload.videoId);",
                  "  pm.collectionVariables.set('processingPollAttempts', '0');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "/Users/eriveltonmessiasmessias/postech-arch-software/projects/hackton-fiap/video-worker-api/postman/assets/sample-video.mp4",
                  "contentType": "video/mp4"
                }
              ]
            },
            "url": "{{kongBaseUrl}}/videos",
            "description": "O MP4 de teste ja esta configurado pelo caminho absoluto desta maquina."
          }
        },
        {
          "name": "02 - Aguardar processamento",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const video = pm.response.json();",
                  "if (video.status === 'PROCESSED') {",
                  "  pm.test('Worker processou e Manager confirmou o resultado', () => {",
                  "    pm.expect(video.videoId).to.eql(pm.collectionVariables.get('videoId'));",
                  "  });",
                  "  pm.collectionVariables.set('processingPollAttempts', '0');",
                  "} else if (video.status === 'FAILED') {",
                  "  pm.test('Processamento nao falhou', () => pm.expect.fail('Status final FAILED'));",
                  "} else {",
                  "  const attempts = Number(pm.collectionVariables.get('processingPollAttempts') || 0) + 1;",
                  "  pm.collectionVariables.set('processingPollAttempts', String(attempts));",
                  "  if (attempts < 60) {",
                  "    setTimeout(() => pm.execution.setNextRequest(pm.info.requestName), 1000);",
                  "  } else {",
                  "    pm.test('Processamento terminou em ate 60 tentativas', () => {",
                  "      pm.expect.fail(`Ultimo status: ${video.status}`);",
                  "    });",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{kongBaseUrl}}/videos/{{videoId}}",
            "description": "No Collection Runner repete automaticamente enquanto o status for pendente. No envio manual, clique Send novamente."
          }
        },
        {
          "name": "03 - Download do ZIP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Manager entregou o ZIP gerado pelo Worker', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('zip');",
                  "  pm.expect(pm.response.responseSize).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{kongBaseUrl}}/videos/{{videoId}}/download",
            "description": "Use Send and Download no Postman para salvar o ZIP."
          }
        }
      ]
    },
    {
      "name": "03 - Validacao final",
      "item": [
        {
          "name": "01 - Listar videos do cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Lista contem o video processado', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const ids = pm.response.json().content.map(video => video.videoId);",
                  "  pm.expect(ids).to.include(pm.collectionVariables.get('videoId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{kongBaseUrl}}/videos?page=0&size=20"
          }
        },
        {
          "name": "02 - Confirmar Grafana depois do fluxo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Grafana continua disponivel para consultar o fluxo', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().database).to.eql('ok');",
                  "});",
                  "console.log(`Abra o Grafana em: ${pm.variables.replaceIn('{{grafanaUrl}}')}`);",
                  "console.log(`Customer ID: ${pm.collectionVariables.get('customerId')}`);",
                  "console.log(`Video ID: ${pm.collectionVariables.get('videoId')}`);",
                  "console.log(`Ultimo X-Request-ID: ${pm.collectionVariables.get('lastRequestId')}`);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{grafanaUrl}}/api/health"
          }
        }
      ]
    }
  ]
}
